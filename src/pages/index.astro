---
import Base from '../layouts/Base.astro';
import Koziolek from '../components/Koziolek.astro';
import { Content as OMnie } from '../../tresc/o-mnie.md';
import { site } from '../site';
---
<Base>
  <section class="hero">
    <Koziolek />
    <h1>O mnie</h1>
    <div class="prose home-about">
      <OMnie />

      <h2>Kontakt</h2>
      <p>
        Masz rozwiązanie, pytanie albo znalazłeś błąd w zadaniu? Napisz:{" "}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</Base>
